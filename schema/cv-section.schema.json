{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cv-section.schema.json",
  "title": "cv-gen section file",
  "description": "One content/*.yaml section file. The 'type' key selects which shape applies. Structure only - marker semantics are not expressible here.",
  "type": "object",
  "oneOf": [
    {
      "title": "labels section",
      "description": "Skills. Renders as: `**Label**: text`, one per line",
      "type": "object",
      "properties": {
        "title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "en"
              ],
              "minProperties": 1
            }
          ],
          "description": "Heading rendered above the section."
        },
        "type": {
          "const": "labels"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "required": [
                      "en"
                    ],
                    "minProperties": 1
                  }
                ],
                "description": "The bolded label before the colon."
              },
              "text": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "required": [
                      "en"
                    ],
                    "minProperties": 1
                  }
                ],
                "description": "Markdown, may carry a marker. A leading '+ ' or '-[variant] ' marker is honoured; the space is required, and it is read from the en text only."
              }
            },
            "required": [
              "label",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    {
      "title": "entries section",
      "description": "Experience, Education. Renders as: **Org**, Location - right-aligned date; *italic role*; bullets",
      "type": "object",
      "properties": {
        "title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "en"
              ],
              "minProperties": 1
            }
          ],
          "description": "Heading rendered above the section."
        },
        "type": {
          "const": "entries"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "org": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "required": [
                      "en"
                    ],
                    "minProperties": 1
                  }
                ],
                "description": "Organisation, rendered bold."
              },
              "location": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "required": [
                      "en"
                    ],
                    "minProperties": 1
                  }
                ],
                "description": "Rendered after the org, unbolded."
              },
              "dates": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "required": [
                      "en"
                    ],
                    "minProperties": 1
                  }
                ],
                "description": "Rendered flush right on the org line."
              },
              "role": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string"
                    },
                    "required": [
                      "en"
                    ],
                    "minProperties": 1
                  }
                ],
                "description": "Rendered italic on its own line."
              },
              "mark": {
                "type": "string",
                "pattern": "^[+-](\\[[^\\]]*\\])?$",
                "description": "Marker for the whole entry, e.g. '+' or '-[a,b]'."
              },
              "bullets": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                      "propertyNames": {
                        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                      },
                      "additionalProperties": {
                        "type": "string"
                      },
                      "required": [
                        "en"
                      ],
                      "minProperties": 1
                    }
                  ]
                },
                "description": "Markdown bullets, each may carry a marker."
              }
            },
            "required": [
              "org",
              "location",
              "dates",
              "role"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "type",
        "entries"
      ],
      "additionalProperties": false
    },
    {
      "title": "rows section",
      "description": "Awards & Grants. Renders as: one line, text left - date right",
      "type": "object",
      "properties": {
        "title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
