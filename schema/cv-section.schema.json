        },
        "type": {
          "const": "rows"
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Shorthand for {text: ...}."
              },
              {
                "type": "object",
                "description": "Localized shorthand for {text: ...}.",
                "propertyNames": {
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "required": [
                  "en"
                ],
                "minProperties": 1
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                        "propertyNames": {
                          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                        },
                        "additionalProperties": {
                          "type": "string"
                        },
                        "required": [
                          "en"
                        ],
                        "minProperties": 1
                      }
                    ],
                    "description": "Markdown, may carry a marker. A leading '+ ' or '-[variant] ' marker is honoured; the space is required, and it is read from the en text only."
                  },
                  "date": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                        "propertyNames": {
                          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                        },
                        "additionalProperties": {
                          "type": "string"
                        },
                        "required": [
                          "en"
                        ],
                        "minProperties": 1
                      }
                    ],
                    "description": "Rendered flush right on the same line."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "title",
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    {
      "title": "prose section",
      "description": "Publications. Renders as: markdown paragraph with hanging indent",
      "type": "object",
      "properties": {
        "title": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
              "propertyNames": {
                "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
              },
              "additionalProperties": {
                "type": "string"
              },
              "required": [
                "en"
              ],
              "minProperties": 1
            }
          ],
          "description": "Heading rendered above the section."
        },
        "type": {
          "const": "prose"
        },
        "items": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "description": "Shorthand for {text: ...}."
              },
              {
                "type": "object",
                "description": "Localized shorthand for {text: ...}.",
                "propertyNames": {
                  "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "required": [
                  "en"
                ],
                "minProperties": 1
              },
              {
                "type": "object",
                "properties": {
                  "text": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "description": "Per-language text. 'en' is the source; any declared language may be added and falls back to en when absent.",
                        "propertyNames": {
                          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                        },
                        "additionalProperties": {
                          "type": "string"
                        },
                        "required": [
                          "en"
                        ],
                        "minProperties": 1
                      }
                    ],
                    "description": "Markdown, may carry a marker. A leading '+ ' or '-[variant] ' marker is honoured; the space is required, and it is read from the en text only."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
